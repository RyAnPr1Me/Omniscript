{
  "name": "omniscript",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "omni": "./dist/cli.js",
    "omniscript-installer": "./dist/bin/installManager.ts"
  },
  "dependencies": {
    "antlr4": "^4.13.1",
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "@eslint/js": "^8.56.0",
    "eslint-config-prettier": "^9.0.0"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "chmod +x dist/bin/install.js && chmod +x dist/cli.js",
    "build:exe": "npm run build && pkg . --targets node16-win-x64,node16-linux-x64,node16-macos-x64 --output dist/bin/omniscript-installer",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "targets": [
      "node16-win-x64",
      "node16-linux-x64",
      "node16-macos-x64"
    ],
    "outputPath": "dist/bin",
    "entries": [
      "dist/cli.js",
      "dist/bin/install.js"
    ],
    "assets": [
      "dist/**/*",
      "src/**/*",
      "stdlib/**/*",
      "package.json",
      "tsconfig.json"
    ]
  }
}

