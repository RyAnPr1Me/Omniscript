{
  "name": "omniscript",
  "version": "0.1.0",
  "bin": {
    "omni-install": "./dist/bin/install.js",
    "omni": "./dist/cli.js"
  },
  "dependencies": {
    "antlr4": "^4.13.1",
    "commander": "^11.0.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.2",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "ts-jest": "^29.1.1"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "chmod +x dist/bin/install.js",
    "build:exe": "npm run build && pkg dist/cli.js -t node16-win-x64,node16-linux-x64,node16-macos-x64 -o dist/bin/omniscript-cli && pkg dist/bin/install.js -t node16-win-x64,node16-linux-x64,node16-macos-x64 -o dist/bin/omniscript-installer",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "pkg": {
    "scripts": ["dist/**/*.js"],
    "targets": [
      "node16-win-x64",
      "node16-linux-x64",
      "node16-macos-x64"
    ],
    "outputPath": "dist/bin",
    "entries": [
      "dist/cli.js",
      "dist/bin/install.js"
    ],
    "assets": [
      "dist/**/*",
      "src/**/*",
      "stdlib/**/*",
      "package.json",
      "tsconfig.json"
    ]
  }
}
