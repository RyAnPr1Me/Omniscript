{
  "name": "omniscript",
  "version": "2.1.0",
  "description": "A modern programming language for full-stack development with type safety, async/await, pattern matching, and built-in ORM",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "omni": "./bin/cli.js",
    "omniscript-installer": "./dist/bin/installManager.js"
  },
  "keywords": [
    "programming-language",
    "typescript",
    "full-stack",
    "orm",
    "type-safety",
    "async-await",
    "pattern-matching",
    "jit-compiler",
    "cli-tool"
  ],
  "author": "RyAnPr1Me",
  "license": "MIT",
  "homepage": "https://github.com/RyAnPr1Me/Omniscript#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RyAnPr1Me/Omniscript.git"
  },
  "bugs": {
    "url": "https://github.com/RyAnPr1Me/Omniscript/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "build:exe": "npm run build && pkg dist/cli.js --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/bin/omniscript-cli && pkg dist/bin/install.js --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/bin/omniscript-installer",
    "prepare:installer": "npm ci --omit=dev && npm run build",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch --config jest.config.ts",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist node_modules coverage",
    "verify": "npm run format:check && npm run lint && npm run build && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run lint"
  },
  "dependencies": {
    "antlr4": "^4.13.1",
    "commander": "^11.0.0",
    "pg": "^8.11.5",
    "sqlite3": "^5.1.7",
    "typescript": "^5.8.3",
    "wabt": "^1.0.38"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.13",
    "@types/pg": "^8.10.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "prettier": "^3.2.5",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
