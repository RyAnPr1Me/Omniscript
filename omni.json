{
  "stdlib": {
    "modules": [
      "collections",
      "io",
      "network",
      "crypto",
      "datetime",
      "math",
      "threading",
      "http"
    ],
    "plugins": []
  },
  "compiler": {
    "target": "es2020",
    "moduleResolution": "node",
    "strict": true,
    "optimizations": {
      "jit": true,
      "simd": true,
      "parallelExecution": true
    }
  },
  "packageManager": {
    "registry": "https://registry.omniscript.dev",
    "cacheDir": ".omni/cache"
  },
  "platforms": [
    "linux-x86_64",
    "linux-arm64",
    "macos-x86_64",
    "macos-arm64",
    "windows-x86_64",
    "wasm"
  ]
}
