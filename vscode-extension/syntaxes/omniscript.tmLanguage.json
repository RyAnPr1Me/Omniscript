{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Omniscript",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#types"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.omniscript",
          "match": "\\b(if|else|while|for|do|break|continue|return|try|catch|finally|throw|switch|case|default)\\b"
        },
        {
          "name": "keyword.other.omniscript",
          "match": "\\b(function|class|interface|type|enum|namespace|module|import|export|from|as|extends|implements|new|this|super|static|public|private|protected|readonly|abstract|async|await|yield|get|set|constructor)\\b"
        },
        {
          "name": "storage.type.omniscript",
          "match": "\\b(let|const|var)\\b"
        },
        {
          "name": "constant.language.omniscript",
          "match": "\\b(true|false|null|undefined|void|never|any|unknown)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.omniscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.omniscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.omniscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.omniscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.template.omniscript",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "meta.embedded.expression.omniscript",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "name": "constant.character.escape.omniscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.omniscript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.omniscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.omniscript",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.hex.omniscript",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.omniscript",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.omniscript",
          "match": "\\b0[oO][0-7]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.omniscript",
          "match": "=|\\+=|\\-=|\\*=|\\/=|%=|\\|=|&=|\\^=|<<=|>>=|>>>=|\\?\\?="
        },
        {
          "name": "keyword.operator.comparison.omniscript",
          "match": "==|!=|===|!==|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.omniscript",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.omniscript",
          "match": "\\+|\\-|\\*|\\/|%|\\+\\+|\\-\\-"
        },
        {
          "name": "keyword.operator.bitwise.omniscript",
          "match": "&|\\||\\^|~|<<|>>|>>>"
        },
        {
          "name": "keyword.operator.other.omniscript",
          "match": "\\?|:|\\?\\?|\\?\\.|=>"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.omniscript",
          "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$]*(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.omniscript",
          "match": "\\b(string|number|boolean|object|symbol|bigint)\\b"
        },
        {
          "name": "entity.name.type.omniscript",
          "match": "\\b[A-Z][a-zA-Z0-9_$]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.omniscript",
          "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.omniscript"
}
